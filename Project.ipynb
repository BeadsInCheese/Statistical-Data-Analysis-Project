# Import necessary libraries
import pandas as pd
from sklearn.cluster import KMeans
import matplotlib.pyplot as plt
import seaborn as sns

# Load the dataset
data_file_path = "path_to_your_data/habits.data"
relevant_columns = ["kohde", "jasen", "pvknro", "sp", "IKAL1", "ASALUE", "V1", "V21", "V32", "V40"]
data = pd.read_csv(data_file_path, sep=";", usecols=relevant_columns)

# Function to convert time strings (e.g., "07:20") to minutes
def time_to_minutes(value):
    try:
        if isinstance(value, str) and ":" in value:
            hours, minutes = map(int, value.split(":"))
            return hours * 60 + minutes
        return int(value)
    except ValueError:
        return None

# Clean the time-based variables
time_vars = ["V1", "V21", "V32", "V40"]
for var in time_vars:
    data[var] = data[var].apply(time_to_minutes)

# Drop rows with missing values
data = data.dropna(subset=time_vars)

# --- Question 3: Characterizing Individuals ---
# Prepare data for clustering using demographic variables
clustering_vars = ["sp", "IKAL1", "ASALUE"]
X = data[clustering_vars]

# Apply k-means clustering
kmeans = KMeans(n_clusters=3, random_state=42)
data['Cluster'] = kmeans.fit_predict(X)

# Print cluster centers for interpretation
print("Cluster Centers:")
print(kmeans.cluster_centers_)

# Visualize clusters
plt.figure(figsize=(8, 6))
sns.scatterplot(x=X["sp"], y=X["IKAL1"], hue=data['Cluster'], palette="viridis", s=50)
plt.xlabel('Sex (1=Male, 2=Female)')
plt.ylabel('Age Group')
plt.title('Demographic Clusters')
plt.legend(title='Cluster')
plt.show()

# --- Question 4: Estimating Average Daily Time on Activities ---
# Calculate mean time for each activity
activity_means = data[time_vars].mean()

# Print results
print("Average Time Spent on Activities (in minutes):")
print(activity_means)

# Visualize average time spent
activity_means.plot(kind='bar', color='skyblue', figsize=(8, 6))
plt.title('Average Daily Time Spent on Activities')
plt.ylabel('Minutes')
plt.xlabel('Activities')
plt.xticks(rotation=45)
plt.show()

# Save the results to a CSV file
output_file_path = "average_activity_time.csv"
activity_means.to_csv(output_file_path, header=True)
print(f"Activity averages saved to {output_file_path}")
