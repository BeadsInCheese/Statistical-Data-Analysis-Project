   ],
   "source": [
    "data[\"sleeping\"]=data[\"sleeping\"].apply(timeFormatter)\n",
    "data[\"working\"]=data[\"working\"].apply(timeFormatter)\n",
    "data[\"childcare\"]=data[\"childcare\"].apply(timeFormatter)\n",
    "data[\"studying in school\"]=data[\"studying in school\"].apply(timeFormatter)"
   ]
  },
