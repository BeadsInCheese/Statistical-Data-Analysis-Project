   "metadata": {},
   "outputs": [],
   "source": [
    "def timeFormatter(time):\n",
    "    temp=str(time)\n",
    "    splits=temp.split(\":\")\n",
    "    s=0\n",
    "    for i in range(len(splits)):\n",
    "        if(splits[i]!=\"nan\" or None):\n",
    "            #print(\"val \",splits[i])\n",
    "            #print(time,\" : \",int(splits[i])*60**(len(splits)-1-i))\n",
    "            s+=int(splits[i])*60**(len(splits)-1-i)\n",
    "        else:\n",
    "            print(\"invalid value : \", time)\n",
    "    return s\n",
    "\n",
    "    "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
