   "outputs": [],
   "source": [
    "variables = [\"kohde\",\"jasen\",\"pvknro\",\"sp\",\"IKAL1\",\"ASALUE\",\"V1\",\"V21\",\"V32\",\"V40\",\"H1a_A\",\"H1h_A\"]\n",
    "#Documentation in habits.text\n",
    "data=pd.read_csv(\"habits.data\",delimiter=\";\",na_values=\"?\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [],
   "source": [
    "#remove extra variables\n",
    "data=data[variables]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [],
   "source": [
    "data.rename(columns={'pvknro':'day of week','sp': 'sex', 'IKAL1': 'age group', 'ASALUE': 'living environment', 'V1': 'working', 'V21': 'childcare', 'V32': 'sleeping', 'V33': 'dining', 'V40': 'studying in school', 'H1a_A': 'cinema', 'H1h_A': 'library'}, inplace=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "Index(['kohde', 'jasen', 'day of week', 'sex', 'age group',\n",
       "       'living environment', 'working', 'childcare', 'sleeping',\n",
